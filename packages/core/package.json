{
  "name": "@places-compat/core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "lint": "biome ci src test tsconfig.json test/types/tsconfig.json vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:nocov": "vitest run",
    "test:types": "node ../../scripts/test-types.mjs",
    "check:differences": "node ../../scripts/check-docs.mjs differences",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:types && pnpm check:differences"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.10",
    "@types/google.maps": "3.66.10",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-places-autocomplete": "7.2.14",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "upstream-rga": "npm:react-google-autocomplete@2.7.5",
    "upstream-rpa": "npm:react-places-autocomplete@7.3.0",
    "upstream-upa": "npm:use-places-autocomplete@4.0.1"
  }
}
