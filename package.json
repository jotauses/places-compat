{
  "name": "places-compat",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "lint": "biome ci packages scripts biome.json tsconfig.base.json vitest.shared.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/check-docs.test.mjs",
    "test:nocov": "pnpm -r test:nocov",
    "test:types": "pnpm -r test:types",
    "build": "pnpm -r build",
    "check:dist": "node scripts/check-dist.mjs",
    "check:tarball": "node scripts/check-tarball.mjs",
    "check:differences": "node scripts/check-docs.mjs differences",
    "test:react": "node scripts/test-react.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:types && pnpm build && pnpm check:dist && pnpm check:tarball && pnpm check:differences"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "expect-type": "1.4.0",
    "jsdom": "31.0.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
